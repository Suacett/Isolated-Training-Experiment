# =============================================================================
# Proxmox AI Stock Predictor - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=stock_predictor

# -----------------------------------------------------------------------------
# Alpha Vantage API (Optional but Recommended)
# Get a free key: https://www.alphavantage.co/support/#api-key
# Used for: EPS data, intrinsic value calculations, news sentiment
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Multiple keys for higher throughput (comma-separated)
# ALPHA_VANTAGE_KEYS=key1,key2,key3
